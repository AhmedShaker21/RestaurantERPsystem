@model IEnumerable<RestaurantERP.Models.DiningTable>
@{
    ViewData["Title"] = "Tables";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header">
    <div>
        <h1 class="page-title" data-t="tables">Tables</h1>
        <p class="page-subtitle">@Model.Count() <span data-t="totalTables">total tables</span></p>
    </div>
</div>

<!-- Status Legend -->
<div class="d-flex gap-3 flex-wrap" style="margin-bottom:24px">
    @{
        var statusData = new[] {
            ("Available", "#4CAF50", "fa-check-circle"),
            ("Occupied", "#FF9800", "fa-user-friends"),
            ("Reserved", "#45B7D1", "fa-calendar-check"),
            ("Cleaning", "#9E9E9E", "fa-broom")
        };
    }
    @foreach (var (name, color, icon) in statusData)
    {
        var count = Model.Count(t => t.Status.ToString() == name);
        <div class="card" style="padding:16px 24px;border-left:4px solid @color;min-width:160px;flex:1">
            <div class="d-flex align-items-center gap-3">
                <i class="fas @icon" style="color:@color;font-size:22px"></i>
                <div>
                    <div style="font-size:22px;font-weight:700">@count</div>
                    <div style="color:var(--text-muted);font-size:13px">@name</div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Tables Grid -->
<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:16px">
    @foreach (var table in Model.OrderBy(t => t.TableNumber))
    {
     
            var result = table.Status switch {
                RestaurantERP.Models.TableStatus.Available => ("#4CAF50", "fa-check-circle"),
                RestaurantERP.Models.TableStatus.Occupied => ("#FF9800", "fa-user-friends"),
                RestaurantERP.Models.TableStatus.Reserved => ("#45B7D1", "fa-calendar-check"),
                RestaurantERP.Models.TableStatus.Cleaning => ("#9E9E9E", "fa-broom"),
                _ => ("#aaa", "fa-circle")
            };
            var statusColor = result.Item1;
            var statusIcon = result.Item2;
        
        <div class="card" style="padding:20px;text-align:center;border-top:4px solid @statusColor;cursor:pointer;transition:transform 0.2s" onmouseover="this.style.transform='translateY(-4px)'" onmouseout="this.style.transform=''" onclick="showTableDetails(@table.Id)">
            <div style="font-size:42px;font-weight:800;color:@statusColor;line-height:1">@table.TableNumber</div>
            <div style="font-size:12px;color:var(--text-muted);margin:4px 0 8px" data-t="tableLabel">TABLE</div>
            <div style="margin-bottom:8px">
                <span class="badge" style="background:@(statusColor)22;color:@statusColor">
                    <i class="fas @statusIcon me-1" style="font-size:10px"></i>@table.Status
                </span>
            </div>
            <div style="font-size:12px;color:var(--text-muted)">
                <i class="fas fa-users me-1"></i>@table.Capacity <span data-t="seats">seats</span>
            </div>
            @if (!string.IsNullOrEmpty(table.Section))
            {
                <div style="font-size:11px;color:var(--text-muted);margin-top:4px">@table.Section</div>
            }
        </div>
    }
</div>

<!-- Table Detail Modal -->
<div class="modal-overlay" id="tableModal">
    <div class="modal" style="max-width:420px">
        <div class="modal-header">
            <h3 class="modal-title" id="tableModalTitle">Table Details</h3>
            <button class="modal-close" onclick="Modal.close('tableModal')">&times;</button>
        </div>
        <div class="modal-body" id="tableModalBody"></div>
        <div class="modal-footer">
            <button class="btn btn-outline" onclick="Modal.close('tableModal')" data-t="close">Close</button>
            <button class="btn btn-primary" onclick="updateTableStatus()" id="updateStatusBtn">
                <i class="fas fa-sync me-2"></i><span data-t="updateStatus">Update Status</span>
            </button>
        </div>
    </div>
</div>

@section Scripts {
<script>
const tablesData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.Select(t => new {
    id = t.Id, tableNumber = t.TableNumber, capacity = t.Capacity, status = t.Status.ToString(), section = t.Section
})));

let selectedTableId = null;

function showTableDetails(id) {
    const table = tablesData.find(t => t.id === id);
    if (!table) return;
    selectedTableId = id;
    document.getElementById('tableModalTitle').textContent = `Table ${table.tableNumber}`;
    const statusColors = { Available: '#4CAF50', Occupied: '#FF9800', Reserved: '#45B7D1', Cleaning: '#9E9E9E' };
    document.getElementById('tableModalBody').innerHTML = `
        <div style="text-align:center;margin-bottom:20px">
            <div style="font-size:64px;font-weight:800;color:${statusColors[table.status] || '#aaa'};line-height:1">${table.tableNumber}</div>
            <span class="badge" style="background:${(statusColors[table.status]||'#aaa')}22;color:${statusColors[table.status]||'#aaa'};font-size:13px;padding:6px 16px;margin-top:8px;display:inline-block">${table.status}</span>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:16px">
            <div style="padding:12px;background:var(--bg-secondary);border-radius:8px;text-align:center">
                <div style="font-size:22px;font-weight:700">${table.capacity}</div>
                <div style="font-size:12px;color:var(--text-muted)">Capacity</div>
            </div>
            <div style="padding:12px;background:var(--bg-secondary);border-radius:8px;text-align:center">
                <div style="font-size:14px;font-weight:600">${table.section || 'N/A'}</div>
                <div style="font-size:12px;color:var(--text-muted)">Section</div>
            </div>
        </div>
        <div class="form-group">
            <label class="form-label">Change Status</label>
            <select id="newTableStatus" class="form-control">
                <option value="Available" ${table.status==='Available'?'selected':''}>Available</option>
                <option value="Occupied" ${table.status==='Occupied'?'selected':''}>Occupied</option>
                <option value="Reserved" ${table.status==='Reserved'?'selected':''}>Reserved</option>
                <option value="Cleaning" ${table.status==='Cleaning'?'selected':''}>Cleaning</option>
            </select>
        </div>
    `;
    Modal.open('tableModal');
}

async function updateTableStatus() {
    if (!selectedTableId) return;
    const status = document.getElementById('newTableStatus').value;
    try {
        const res = await API.post('/Admin/UpdateTableStatus', { tableId: selectedTableId, status });
        if (res.success) { Toast.success('Table status updated'); setTimeout(() => location.reload(), 600); }
        else Toast.error(res.message || 'Failed');
    } catch(e) { Toast.error('Error updating table'); }
}
</script>
}
