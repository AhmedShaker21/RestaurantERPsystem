@model IEnumerable<RestaurantERP.Models.Expense>
@{
    ViewData["Title"] = "Expenses";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var thisMonth = Model.Where(e => e.Date.Month == DateTime.Today.Month && e.Date.Year == DateTime.Today.Year).ToList();
}

<div class="page-header">
    <div>
        <h1 class="page-title" data-t="expenses">Expenses</h1>
        <p class="page-subtitle" data-t="trackExpenses">Track and manage restaurant expenses</p>
    </div>
    <button class="btn btn-primary" onclick="Modal.open('addExpenseModal')">
        <i class="fas fa-plus me-2"></i><span data-t="addExpense">Add Expense</span>
    </button>
</div>

<div class="stats-grid" style="grid-template-columns:repeat(4,1fr);margin-bottom:24px">
    <div class="stat-card" style="margin-top:15px;">
        <div class="stat-icon" style="background:#FF6B6B22;color:#FF6B6B"><i class="fas fa-receipt"></i></div>
        <div class="stat-value">@Model.Count()</div>
        <div class="stat-label" data-t="totalExpenses">Total Expenses</div>
    </div>
    <div class="stat-card" style="margin-top:15px;">
        <div class="stat-icon" style="background:#FF980022;color:#FF9800"><i class="fas fa-calendar"></i></div>
        <div class="stat-value">@thisMonth.Count</div>
        <div class="stat-label" data-t="thisMonth">This Month</div>
    </div>
    <div class="stat-card" style="margin-top:15px;">
        <div class="stat-icon" style="background:#45B7D122;color:#45B7D1"><i class="fas fa-coins"></i></div>
        <div class="stat-value">@Model.Sum(e => e.Amount).ToString("F0") EGP</div>
        <div class="stat-label" data-t="totalAmount">Total Amount</div>
    </div>
    <div class="stat-card" style="margin-top:15px;">
        <div class="stat-icon" style="background:#96CEB422;color:#96CEB4"><i class="fas fa-chart-line"></i></div>
        <div class="stat-value">@thisMonth.Sum(e => e.Amount).ToString("F0") EGP</div>
        <div class="stat-label" data-t="monthlyTotal">Monthly Total</div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <div class="d-flex gap-3 align-items-center">
            <input type="text" class="form-control" style="max-width:220px" placeholder="Search expenses..." oninput="filterExpenses(this.value)">
            <select id="catFilter" class="form-control" style="max-width:180px" onchange="filterExpenses('')">
                <option value="">All Categories</option>
                @foreach (var cat in Model.Select(e => e.Category).Distinct().Where(c => !string.IsNullOrEmpty(c)))
                {
                    <option value="@cat">@cat</option>
                }
            </select>
        </div>
    </div>
    <div class="table-container">
        <table class="data-table" id="expensesTable">
            <thead>
                <tr>
                    <th data-t="date">Date</th>
                    <th data-t="title">Title</th>
                    <th data-t="category">Category</th>
                    <th data-t="amount">Amount</th>
                    <th data-t="paymentMethod">Payment</th>
                    <th data-t="recordedBy">Recorded By</th>
                    <th data-t="notes">Notes</th>
                    <th data-t="actions">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in Model.OrderByDescending(x => x.Date))
                {
                    <tr data-cat="@e.Category">
                        <td>@e.Date.ToString("MM/dd/yyyy")</td>
                        <td><strong>@e.Title</strong></td>
                        <td>
                            <span class="badge badge-primary">@(e.Category ?? "Other")</span>
                        </td>
                        <td style="color:var(--danger);font-weight:600">@e.Amount.ToString("F2") EGP</td>
                        <td>@(e.PaymentMethod)</td>
                        <td style="font-size:12px">@(e.RecordedBy?.UserName ?? "-")</td>
                        <td style="font-size:12px;color:var(--text-muted)">@e.Description</td>
                        <td>
                            <button class="btn btn-sm btn-outline" onclick="deleteExpense(@e.Id, '@e.Title')" style="color:var(--danger)">
                                <i class="fas fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Add Expense Modal -->
<div class="modal-overlay" id="addExpenseModal">
    <div class="modal" style="max-width:480px">
        <div class="modal-header">
            <h3 class="modal-title" data-t="addExpense">Add Expense</h3>
            <button class="modal-close" onclick="Modal.close('addExpenseModal')">&times;</button>
        </div>
        <div class="modal-body">
            <div class="form-group">
                <label class="form-label" data-t="title">Title</label>
                <input type="text" id="expTitle" class="form-control" placeholder="e.g. Vegetable Supply">
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
                <div class="form-group">
                    <label class="form-label" data-t="amount">Amount (EGP)</label>
                    <input type="number" id="expAmount" class="form-control" placeholder="0.00" step="0.01" min="0">
                </div>
                <div class="form-group">
                    <label class="form-label" data-t="date">Date</label>
                    <input type="date" id="expDate" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")">
                </div>
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
                <div class="form-group">
                    <label class="form-label" data-t="category">Category</label>
                    <select id="expCategory" class="form-control">
                        <option>Ingredients</option>
                        <option>Utilities</option>
                        <option>Salaries</option>
                        <option>Equipment</option>
                        <option>Marketing</option>
                        <option>Maintenance</option>
                        <option>Other</option>
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label" data-t="paymentMethod">Payment Method</label>
                    <select id="expPayment" class="form-control">
                        <option value="0">Cash</option>
                        <option value="1">Card</option>
                        <option value="2">Digital</option>
                    </select>
                </div>
            </div>
            <div class="form-group">
                <label class="form-label" data-t="notes">Notes (optional)</label>
                <textarea id="expNotes" class="form-control" rows="2" placeholder="Additional details..."></textarea>
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn btn-outline" onclick="Modal.close('addExpenseModal')" data-t="cancel">Cancel</button>
            <button class="btn btn-primary" onclick="saveExpense()">
                <i class="fas fa-save me-2"></i><span data-t="save">Save Expense</span>
            </button>
        </div>
    </div>
</div>

@section Scripts {
<script>
function filterExpenses(search) {
    const cat = document.getElementById('catFilter').value;
    const s = (search || document.querySelector('input[type=text]').value).toLowerCase();
    document.querySelectorAll('#expensesTable tbody tr').forEach(row => {
        row.style.display = (!s || row.textContent.toLowerCase().includes(s)) && (!cat || row.dataset.cat === cat) ? '' : 'none';
    });
}

async function saveExpense() {
        const payload = {
            title: document.getElementById('expTitle').value,
            amount: parseFloat(document.getElementById('expAmount').value) || 0,
            date: document.getElementById('expDate').value,
            category: document.getElementById('expCategory').value,
            paymentMethod: parseInt(document.getElementById('expPayment').value),
            description: document.getElementById('expNotes').value
        };
    if (!payload.title || payload.amount <= 0) { Toast.warning('Please fill in title and amount'); return; }
    try {
        const res = await API.post('/Admin/SaveExpense', payload);
        if (res.success) { Toast.success('Expense saved'); setTimeout(() => location.reload(), 800); }
        else Toast.error(res.message || 'Failed');
    } catch(e) { Toast.error('Error saving expense'); }
}

async function deleteExpense(id, title) {
    if (!confirm(`Delete expense "${title}"?`)) return;
    try {
        const res = await API.post('/Admin/DeleteExpense', { id });
        if (res.success) { Toast.success('Expense deleted'); setTimeout(() => location.reload(), 600); }
        else Toast.error(res.message || 'Failed');
    } catch(e) { Toast.error('Error'); }
}
</script>
}
