@model IEnumerable<RestaurantERP.Models.Category>
@{
    ViewData["Title"] = "Categories";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header">
    <div>
        <h1 class="page-title" data-t="categories">Categories</h1>
        <p class="page-subtitle">@Model.Count() <span data-t="totalCategories">total categories</span></p>
    </div>
    <button class="btn btn-primary" onclick="openAddModal()">
        <i class="fas fa-plus me-2"></i><span data-t="addCategory">Add Category</span>
    </button>
</div>

<div class="stats-grid" style="grid-template-columns:repeat(auto-fit,minmax(200px,1fr));margin-bottom:24px">
    @foreach (var cat in Model)
    {
        <div class="stat-card" style="cursor:pointer;border-left:4px solid @cat.ColorHex" onclick="editCategory(@cat.Id)">
            <div class="stat-card-header">
                <div class="stat-icon" style="background:@cat.ColorHex;color:@cat.ColorHex">
                    <i class="fas @cat.Icon"></i>
                </div>
                <div>
                    <span class="badge @(cat.IsActive ? "badge-success" : "badge-danger")" style="font-size:10px">
                        @(cat.IsActive ? "Active" : "Inactive")
                    </span>
                </div>
            </div>
            <div class="stat-value" style="font-size:18px">@cat.Name</div>
            <div class="stat-label">@cat.NameAr</div>
            <div style="margin-top:8px;font-size:13px;color:var(--text-muted)">
                @(cat.Products?.Count ?? 0) <span data-t="products">products</span>
            </div>
        </div>
    }
</div>

<div class="card">
    <div class="card-header">
        <h3 class="card-title" data-t="allCategories">All Categories</h3>
    </div>
    <div class="table-container">
        <table class="data-table">
            <thead>
                <tr>
                    <th data-t="icon">Icon</th>
                    <th data-t="name">Name (EN)</th>
                    <th data-t="nameAr">Name (AR)</th>
                    <th data-t="color">Color</th>
                    <th data-t="products">Products</th>
                    <th data-t="status">Status</th>
                    <th data-t="actions">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var cat in Model)
                {
                    <tr>
                        <td>
                            <div style="width:40px;height:40px;border-radius:10px;background:@cat.ColorHex;display:flex;align-items:center;justify-content:center;color:@cat.ColorHex;font-size:18px">
                                <i class="fas @cat.Icon"></i>
                            </div>
                        </td>
                        <td><strong>@cat.Name</strong></td>
                        <td dir="rtl">@cat.NameAr</td>
                        <td>
                            <div style="display:flex;align-items:center;gap:8px">
                                <div style="width:20px;height:20px;border-radius:50%;background:@cat.ColorHex"></div>
                                <span style="font-family:monospace;font-size:12px">@cat.ColorHex</span>
                            </div>
                        </td>
                        <td>@(cat.Products?.Count ?? 0)</td>
                        <td><span class="badge @(cat.IsActive ? "badge-success" : "badge-danger")">@(cat.IsActive ? "Active" : "Inactive")</span></td>
                        <td>
                            <div class="d-flex gap-2">
                                <button class="btn btn-sm btn-outline" onclick="editCategory(@cat.Id)" title="Edit"><i class="fas fa-edit"></i></button>
                                <button class="btn btn-sm btn-outline" onclick="deleteCategory(@cat.Id, '@cat.Name')" title="Delete" style="color:var(--danger)"><i class="fas fa-trash"></i></button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Category Modal -->
<div class="modal-overlay" id="categoryModal">
    <div class="modal" style="max-width:500px">
        <div class="modal-header">
            <h3 class="modal-title" id="modalTitle" data-t="addCategory">Add Category</h3>
            <button class="modal-close" onclick="Modal.close('categoryModal')">&times;</button>
        </div>
        <div class="modal-body">
            <input type="hidden" id="catId" value="0">
            <div class="form-group">
                <label class="form-label" data-t="nameEn">Name (English)</label>
                <input type="text" id="catName" class="form-control" placeholder="e.g. Beverages">
            </div>
            <div class="form-group">
                <label class="form-label" data-t="nameAr">Name (Arabic)</label>
                <input type="text" id="catNameAr" class="form-control" dir="rtl" placeholder="مثال: المشروبات">
            </div>
            <div class="form-group">
                <label class="form-label" data-t="icon">Icon (FontAwesome class)</label>
                <div style="display:flex;gap:10px;align-items:center">
                    <input type="text" id="catIcon" class="form-control" placeholder="fa-coffee" oninput="updateIconPreview()">
                    <div id="iconPreview" style="width:50px;height:50px;border-radius:10px;background:var(--bg-secondary);display:flex;align-items:center;justify-content:center;font-size:20px;color:var(--primary);flex-shrink:0">
                        <i class="fas fa-star"></i>
                    </div>
                </div>
                <div style="margin-top:10px;display:flex;flex-wrap:wrap;gap:8px">
                    @foreach(var icon in new[]{"fa-coffee","fa-hamburger","fa-pizza-slice","fa-ice-cream","fa-bread-slice","fa-wine-glass","fa-utensils","fa-cookie","fa-fish","fa-drumstick-bite","fa-carrot","fa-apple-alt"})
                    {
                        <button type="button" class="btn btn-sm btn-outline" onclick="selectIcon('@icon')" style="width:36px;height:36px;padding:0">
                            <i class="fas @icon"></i>
                        </button>
                    }
                </div>
            </div>
            <div class="form-group">
                <label class="form-label" data-t="color">Color</label>
                <div style="display:flex;gap:10px;flex-wrap:wrap">
                    @foreach(var color in new[]{"#FF6B6B","#4ECDC4","#45B7D1","#96CEB4","#FFEAA7","#DDA0DD","#FF8C00","#20B2AA","#FF69B4","#7B68EE","#32CD32","#FF4500"})
                    {
                        <div onclick="selectColor('@color')" style="width:32px;height:32px;border-radius:50%;background:@color;cursor:pointer;border:3px solid transparent;transition:all 0.2s" class="color-swatch"></div>
                    }
                    <input type="color" id="catColorPicker" class="form-control" style="width:50px;height:32px;padding:2px;cursor:pointer" onchange="selectColor(this.value)">
                </div>
                <input type="hidden" id="catColor" value="#FF6B6B">
            </div>
            <div class="form-group">
                <label class="form-label" data-t="status">Status</label>
                <div class="d-flex gap-3">
                    <label style="display:flex;align-items:center;gap:8px;cursor:pointer">
                        <input type="checkbox" id="catActive" checked style="width:18px;height:18px">
                        <span data-t="active">Active</span>
                    </label>
                </div>
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn btn-outline" onclick="Modal.close('categoryModal')" data-t="cancel">Cancel</button>
            <button class="btn btn-primary" onclick="saveCategory()" id="saveCatBtn">
                <i class="fas fa-save me-2"></i><span data-t="save">Save</span>
            </button>
        </div>
    </div>
</div>

@section Scripts {
<script>
const categoriesData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.Select(c => new {
    id = c.Id, name = c.Name, nameAr = c.NameAr, icon = c.Icon, colorHex = c.ColorHex, isActive = c.IsActive
})));

function openAddModal() {
    document.getElementById('modalTitle').setAttribute('data-t','addCategory');
    document.getElementById('catId').value = 0;
    document.getElementById('catName').value = '';
    document.getElementById('catNameAr').value = '';
    document.getElementById('catIcon').value = '';
    document.getElementById('catActive').checked = true;
    selectColor('#FF6B6B');
    updateIconPreview();
    Modal.open('categoryModal');
}

function editCategory(id) {
    const cat = categoriesData.find(c => c.id === id);
    if (!cat) return;
    document.getElementById('modalTitle').setAttribute('data-t','editCategory');
    document.getElementById('catId').value = cat.id;
    document.getElementById('catName').value = cat.name;
    document.getElementById('catNameAr').value = cat.nameAr;
    document.getElementById('catIcon').value = cat.icon;
    document.getElementById('catActive').checked = cat.isActive;
    selectColor(cat.colorHex);
    updateIconPreview();
    Modal.open('categoryModal');
}

function updateIconPreview() {
    const icon = document.getElementById('catIcon').value.trim();
    const preview = document.getElementById('iconPreview');
    preview.innerHTML = `<i class="fas ${icon || 'fa-star'}"></i>`;
}

function selectIcon(icon) {
    document.getElementById('catIcon').value = icon;
    updateIconPreview();
}

function selectColor(color) {
    document.getElementById('catColor').value = color;
    document.querySelectorAll('.color-swatch').forEach(s => {
        s.style.border = s.style.background === color ? '3px solid var(--text-primary)' : '3px solid transparent';
    });
    document.getElementById('iconPreview').style.background = color + '22';
    document.getElementById('iconPreview').style.color = color;
}

async function saveCategory() {
    const btn = document.getElementById('saveCatBtn');
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Saving...';
    const payload = {
        id: parseInt(document.getElementById('catId').value),
        name: document.getElementById('catName').value,
        nameAr: document.getElementById('catNameAr').value,
        icon: document.getElementById('catIcon').value,
        colorHex: document.getElementById('catColor').value,
        isActive: document.getElementById('catActive').checked
    };
    try {
        const res = await API.post('/Admin/SaveCategory', payload);
        if (res.success) {
            Toast.success('Category saved successfully');
            setTimeout(() => location.reload(), 800);
        } else {
            Toast.error(res.message || 'Failed to save category');
        }
    } catch(e) { Toast.error('Error saving category'); }
    btn.disabled = false;
    btn.innerHTML = '<i class="fas fa-save me-2"></i><span data-t="save">Save</span>';
}

async function deleteCategory(id, name) {
    if (!confirm(`Delete category "${name}"? This cannot be undone.`)) return;
    try {
        const res = await API.post('/Admin/DeleteCategory', { id });
        if (res.success) { Toast.success('Category deleted'); setTimeout(() => location.reload(), 800); }
        else Toast.error(res.message || 'Failed to delete');
    } catch(e) { Toast.error('Error deleting category'); }
}
</script>
}
