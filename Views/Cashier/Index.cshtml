   INIT
════════════════════════════════════════════════════════════════ */
document.addEventListener('DOMContentLoaded', () => {
    loadProducts();
    renderCart();
    const activePay = document.querySelector('.payment-btn.active');
    if (activePay) setPayment(0, activePay);
    fetchShiftStatus();   // pre-load so buttons work immediately without refresh
});
</script>
}
